# Forms and Validation Patterns

## Overview

This project uses:
- **react-hook-form** for form state management
- **Zod** for schema validation
- **@hookform/resolvers** to connect Zod with react-hook-form
- **shadcn/ui Form components** for consistent styling

## Schema Location

Validation schemas are co-located with their form components in a `schema/` subdirectory:

```
features/{feature}/components/organisms/
├── create-product-sheet/
│   ├── create-product-sheet.tsx
│   └── schema/
│       └── create-product-schema.ts
├── edit-product-sheet/
│   ├── edit-product-sheet.tsx
│   └── schema/
│       └── edit-product-schema.ts
```

## Schema Pattern with i18n

Always create schemas as hooks to support internationalized error messages:

```typescript
// schema/create-product-schema.ts
import { z } from 'zod';
import { useI18n } from '@/locales/client';
import { ProductStatus } from '@server/db/types/enum/product-status';
import { SizeUnit } from '@server/db/types/enum/size-unit';

export const useCreateProductSchema = () => {
  const t = useI18n();

  return z.object({
    name: z.string().min(1, t('validation.required')),
    sku: z.string().min(1, t('validation.required')),
    categoryId: z.coerce.number({
      invalid_type_error: t('validation.required'),
    }),
    warehouseId: z.coerce.number({
      invalid_type_error: t('validation.required'),
    }),
    purchasePrice: z.coerce
      .number({ invalid_type_error: t('validation.required') })
      .min(0, t('validation.positive')),
    status: z.nativeEnum(ProductStatus),
    sizeUnit: z.nativeEnum(SizeUnit),
    sizes: z.array(
      z.object({
        size: z.string().min(1, t('validation.required')),
        quantity: z.coerce
          .number({ invalid_type_error: t('validation.required') })
          .min(1, t('validation.positive')),
      })
    ),
    notes: z.string().optional(),
  });
};

// Export type for form
export type CreateProductFormData = z.infer<ReturnType<typeof useCreateProductSchema>>;
```

## Common Validation Patterns

### Required String
```typescript
z.string().min(1, t('validation.required'))
```

### Email
```typescript
z.string().email({ message: t('validation.email') })
```

### Coerced Number (from string input)
```typescript
z.coerce.number({ invalid_type_error: t('validation.required') })
```

### Positive Number
```typescript
z.coerce
  .number({ invalid_type_error: t('validation.required') })
  .min(0, t('validation.positive'))
```

### Enum
```typescript
z.nativeEnum(ProductStatus)
// or
z.enum(['option1', 'option2', 'option3'])
```

### Optional Fields
```typescript
z.string().optional()
z.date().optional()
z.coerce.number().optional()
```

### Arrays
```typescript
z.array(
  z.object({
    field1: z.string().min(1, t('validation.required')),
    field2: z.coerce.number(),
  })
)
```

### Password Confirmation
```typescript
const schema = z
  .object({
    password: z.string().min(8, t('validation.passwordMin')),
    confirmPassword: z.string().min(1, t('validation.required')),
  })
  .refine((data) => data.password === data.confirmPassword, {
    message: t('validation.passwordMatch'),
    path: ['confirmPassword'],
  });
```

## Form Component Pattern

```typescript
'use client';

import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import {
  Form,
  FormControl,
  FormField,
  FormItem,
  FormLabel,
  FormMessage,
} from '@/components/ui/form';
import { Input } from '@/components/ui/input';
import { Button } from '@/components/ui/button';

import { useCreateProductSchema, type CreateProductFormData } from './schema/create-product-schema';
import { useCreateProduct } from '../../hooks/mutation/use-create-product';

interface CreateProductFormProps {
  onSuccess?: () => void;
}

export const CreateProductForm = ({ onSuccess }: CreateProductFormProps) => {
  const schema = useCreateProductSchema();
  const { mutate: createProduct, isPending } = useCreateProduct();

  const form = useForm<CreateProductFormData>({
    resolver: zodResolver(schema),
    defaultValues: {
      name: '',
      sku: '',
      purchasePrice: 0,
      notes: '',
    },
    mode: 'onBlur', // Validate on blur
  });

  const onSubmit = (data: CreateProductFormData) => {
    createProduct(data, {
      onSuccess: () => {
        form.reset();
        onSuccess?.();
      },
    });
  };

  return (
    <Form {...form}>
      <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-4">
        <FormField
          control={form.control}
          name="name"
          render={({ field }) => (
            <FormItem>
              <FormLabel>Product Name</FormLabel>
              <FormControl>
                <Input placeholder="Enter product name" {...field} />
              </FormControl>
              <FormMessage />
            </FormItem>
          )}
        />

        <FormField
          control={form.control}
          name="purchasePrice"
          render={({ field }) => (
            <FormItem>
              <FormLabel>Purchase Price</FormLabel>
              <FormControl>
                <Input type="number" step="0.01" {...field} />
              </FormControl>
              <FormMessage />
            </FormItem>
          )}
        />

        <Button type="submit" disabled={isPending}>
          {isPending ? 'Creating...' : 'Create Product'}
        </Button>
      </form>
    </Form>
  );
};
```

## Form in Sheet/Dialog Pattern

Forms in sheets/dialogs should reset on close:

```typescript
'use client';

import { Sheet, SheetContent, SheetHeader, SheetTitle } from '@/components/ui/sheet';
import { useEffect } from 'react';

interface CreateProductSheetProps {
  open: boolean;
  onOpenChange: (open: boolean) => void;
}

export const CreateProductSheet = ({ open, onOpenChange }: CreateProductSheetProps) => {
  const schema = useCreateProductSchema();
  
  const form = useForm<CreateProductFormData>({
    resolver: zodResolver(schema),
    defaultValues: {
      name: '',
    },
  });

  // Reset form when sheet closes
  useEffect(() => {
    if (!open) {
      form.reset();
    }
  }, [open, form]);

  const handleSuccess = () => {
    onOpenChange(false);
  };

  return (
    <Sheet open={open} onOpenChange={onOpenChange}>
      <SheetContent>
        <SheetHeader>
          <SheetTitle>Create Product</SheetTitle>
        </SheetHeader>
        {/* Form content */}
      </SheetContent>
    </Sheet>
  );
};
```

## Form Field Components

### Select Field
```typescript
<FormField
  control={form.control}
  name="categoryId"
  render={({ field }) => (
    <FormItem>
      <FormLabel>Category</FormLabel>
      <Select onValueChange={field.onChange} defaultValue={String(field.value)}>
        <FormControl>
          <SelectTrigger>
            <SelectValue placeholder="Select category" />
          </SelectTrigger>
        </FormControl>
        <SelectContent>
          {categories.map((category) => (
            <SelectItem key={category.id} value={String(category.id)}>
              {category.name}
            </SelectItem>
          ))}
        </SelectContent>
      </Select>
      <FormMessage />
    </FormItem>
  )}
/>
```

### Checkbox Field
```typescript
<FormField
  control={form.control}
  name="isActive"
  render={({ field }) => (
    <FormItem className="flex items-center gap-2">
      <FormControl>
        <Checkbox checked={field.value} onCheckedChange={field.onChange} />
      </FormControl>
      <FormLabel className="!mt-0">Active</FormLabel>
      <FormMessage />
    </FormItem>
  )}
/>
```

### Date Picker Field
```typescript
<FormField
  control={form.control}
  name="purchaseDate"
  render={({ field }) => (
    <FormItem>
      <FormLabel>Purchase Date</FormLabel>
      <FormControl>
        <DatePicker
          value={field.value}
          onChange={field.onChange}
        />
      </FormControl>
      <FormMessage />
    </FormItem>
  )}
/>
```

## Translation Keys

Add validation messages to `src/locales/{lang}/validation.ts`:

```typescript
export default {
  required: 'This field is required',
  email: 'Please enter a valid email',
  positive: 'Value must be positive',
  passwordMin: 'Password must be at least 8 characters',
  passwordMatch: 'Passwords do not match',
} as const;
```

## Form State Hooks

Use these hooks for form-related UI state:

```typescript
import { useDialog } from '@hooks/use-dialog';

const { isOpen, open, close, toggle } = useDialog();
```
